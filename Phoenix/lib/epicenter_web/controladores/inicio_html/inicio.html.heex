<header class="ep-barra">
  <div class="ep-barra__logo">
    <.isotipo tamano={32} />
    <span>Epicenter</span>
  </div>
  <.form for={%{}} action={~p"/salir"} method="delete">
    <button class="ep-boton ep-boton--secundario ep-boton--compacto" type="submit">Salir</button>
  </.form>
</header>

<main class="ep-pagina">
  <.avisos flash={@flash} />
  <h1 class="titulo-1">Hola, {@usuario.nombre_completo || @usuario.nombre_usuario}</h1>
  <p class="cuerpo ep-pagina__texto">
    Ingresaste como {@usuario.rol} en la zona {@usuario.zona || "sin asignar"}.
    Las demás pantallas se construirán aquí.
  </p>
</main>
